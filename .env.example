unifi_url=https://your-unifi-controller-ip
unifi_username=your-username
unifi_password=your-password

# Full path including node name: https://ip:8006/api2/json/nodes/your-node-name
proxmox_url=https://your-proxmox-ip:8006/api2/json/nodes/pve

# Format: user@realm!tokenname=secret-uuid
proxmox_auth=root@pam!tokenname=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
